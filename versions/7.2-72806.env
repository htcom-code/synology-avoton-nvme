# SPDX-License-Identifier: GPL-2.0-only
# DSM 7.2-72806 (avoton). Sourced by build.sh. One file per DSM release — see README.md.

PLATFORM=avoton

# Synology GPL archive: https://archive.synology.com/download/ToolChain/
KERNEL_URL="https://global.synologydownload.com/download/ToolChain/Synology%20NAS%20GPL%20Source/7.2-72806/avoton/linux-3.10.x.txz"
KERNEL_SHA256=227c94c058c979f94aec1384f69acdfd3ec3668c6bd4627bc70df8145cbb738a
KERNEL_DIR_NAME=linux-3.10.x
TOOLCHAIN_URL="https://global.synologydownload.com/download/ToolChain/toolchain/7.2-72806/Intel%20x86%20Linux%203.10.108%20%28Avoton%29/avoton-gcc1220_glibc236_x86_64-GPL.txz"
TOOLCHAIN_SHA256=9c2059088ef7b62f881ee6f740cb95b8eb7409093fb03499edc76b0a7d96b8e9
TOOLCHAIN_PREFIX=x86_64-pc-linux-gnu

# Selects patches/linux-<series>/
KERNEL_SERIES=3.10

# Checks the built module must pass. Measured on a DS1517+ running this DSM release:
#   vermagic of any /lib/modules/*.ko, and its struct module size (tools/modsize.py).
EXPECT_VERMAGIC="3.10.108 SMP mod_unload"
EXPECT_MODSIZE=0x220
# Kernel symbols the module must import (proves the patches are compiled in).
EXPECT_IMPORTS="blk_queue_flush"

# Hardware verification. Set only after the module passed the NAS checks in README.md.
# CI fails if a build of this version no longer reproduces VERIFIED_SHA256.
VERIFIED_SHA256=b75d3a2dc626a8c4c11ed733b802dbeb9700cf06f19e6f05945c7993ebe0476e
VERIFIED_ON=2026-10-22
VERIFIED_NOTE="DS1517+ with M2D18, Samsung SM961-class 256GB (144d:a804). dsync 8KB write 2.77 ms; pg_test_fsync fdatasync 0.87 ms."
